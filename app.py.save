st.info(get_text(st.session_state.language, 'tip'))
 
if 'result' in st.session_state and 'pdf_path' in st.session_state:
    st.success(get_text(st.session_state.language, 'success'))
    st.text_area("", st.session_state.result, height=400, label_visibility="collapsed")
    
    # Email button
    with st.expander("📧 " + get_text(st.session_state.language, 'email_button')):
        user_email = st.text_input(get_text(st.session_state.language, 'enter_email'))
        if st.button(get_text(st.session_state.language, 'email_button')):
            if user_email:
                try:
                    # Note: This is a placeholder - you need to configure SMTP
                    st.info("📧 Email functionality requires SMTP configuration. Please download the PDF instead.")
                    st.info(f"💡 Your PDF is at: {st.session_state.pdf_path}")
                except:
                    st.error(get_text(st.session_state.language, 'email_error'))
            else:
                st.warning("Please enter an email address")
else:
    st.info(get_text(st.session_state.language, 'configure'))
    
    # Benefits
    st.markdown(f"#### {get_text(st.session_state.language, 'what_you_get')}")
    for i in range(1, 7):
        st.markdown(get_text(st.session_state.language, f'benefit{i}'))
output_dir = "output"
if os.path.exists(output_dir):
    pdf_files = [f for f in os.listdir(output_dir) if f.endswith('.pdf')]
    
    if pdf_files:
        pdf_files.sort(reverse=True)
        
        for pdf_file in pdf_files[:5]:
            file_path = os.path.join(output_dir, pdf_file)
            
            with open(file_path, "rb") as f:
                st.download_button(
                    label=f"📥 {pdf_file[:25]}...",
                    data=f,
                    file_name=pdf_file,
                    mime="application/pdf",
                    key=pdf_file,
                    use_container_width=True
                )
    else:
        st.info(get_text(st.session_state.language, 'no_pdfs'))
else:
    st.info(get_text(st.session_state.language, 'no_pdfs'))
progress_bar = st.progress(0)
                status_text = st.empty()
                
           
                time.sleep(0.5)
                
                inputs = {'topic': topic}
                result = crew_instance.crew().kickoff(inputs=inputs)
                
                status_text.markdown(f"### {get_text(st.session_state.language, 'step2')}")
                progress_bar.progress(60)
                time.sleep(0.5)
                
                pdf_generator = MealPlanPDFGenerator(language=st.session_state.language)
                pdf_path = pdf_generator.generate_pdf(str(result), topic)
                
                status_text.markdown(f"### {get_text(st.session_state.language, 'step3')}")
                progress_bar.progress(90)
                time.sleep(0.5)
                
                status_text.markdown(f"### {get_text(st.session_state.language, 'complete')}")
                progress_bar.progress(100)
                
                st.session_state.result = str(result)
                st.session_state.pdf_path = pdf_path
                
                st.balloons()
                st.success(get_text(st.session_state.language, 'success_msg'))
                st.info(f"{get_text(st.session_state.language, 'pdf_saved')} {pdf_path}")
                
                time.sleep(2)
                st.rerun()
                
            except Exception as e:
                st.error(f"❌ Error: {str(e)}")
                
                if 'rate_limit' in str(e).lower() or 'too large' in str(e).lower():
                    st.warning(get_text(st.session_state.language, 'rate_limit'))
                    st.info(get_text(st.session_state.language, 'rate_limit_tip'))


