topic_choice = st.selectbox("", options=list(presets.keys()), label_visibility="collapsed")

if get_text(st.session_state.language, 'custom') in topic_choice:
    topic = st.text_input(get_text(st.session_state.language, 'enter_custom'))
else:
    topic = presets[topic_choice]

