with col2:
    st.markdown(f"### {get_text(st.session_state.language, 'downloads')}")
    
    output_dir = "output"
    if os.path.exists(output_dir):
        pdf_files = [f for f in os.listdir(output_dir) if f.endswith('.pdf')]
        
        if pdf_files:
            pdf_files.sort(reverse=True)
            
            for pdf_file in pdf_files[:5]:
                file_path = os.path.join(output_dir, pdf_file)
                
                with open(file_path, "rb") as f:
                    st.download_button(
                        label=f"📥 {pdf_file[:25]}...",
                        data=f,
                        file_name=pdf_file,
                        mime="application/pdf",
                        key=pdf_file,
                        use_container_width=True
                    )
        else:
            st.info(get_text(st.session_state.language, 'no_pdfs'))
    else:
        st.info(get_text(st.session_state.language, 'no_pdfs'))

